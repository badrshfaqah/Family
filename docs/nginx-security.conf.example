# مثال Nginx آمن عند تشغيل النظام من جذر النطاق.
# عدّل root واسم socket الخاص بـ PHP-FPM قبل الاستخدام.
server {
    listen 443 ssl http2;
    server_name family.example.com;
    root /var/www/family-cms;
    index index.php;

    client_max_body_size 100m;
    autoindex off;

    location ~ /\. { deny all; }
    location = /config.php { deny all; }
    location = /config.sample.php { deny all; }
    location ~* ^/storage/uploads/.*\.(php\d*|phtml|phar|html?|xhtml|shtml|svg|xml|xsl|js|mjs|css|cgi|pl|py|sh)$ { deny all; }

    location /storage/uploads/ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    }
    location /storage/ { deny all; }
    location ~* ^/(core|modules|themes|docs)/.*\.php$ { deny all; }
    location ~* ^/install/steps/.*\.php$ { deny all; }

    location /admin/ {
        try_files $uri $uri/ /admin/index.php?$query_string;
    }
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ ^/(index|admin/index|install/index)\.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_hide_header X-Powered-By;
    }
    location ~ \.php$ { deny all; }
}

# يفضّل أن يكون BACKUP_PATH خارج root، مثل:
# /var/backups/family-cms (ملكية مستخدم PHP وصلاحية 0700).
