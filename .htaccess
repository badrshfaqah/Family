# نظام إدارة محتوى العوائل والقبائل
# توجيه جميع الطلبات غير الموجودة كملفات/مجلدات فعلية إلى index.php
# القاعدة تعمل بشكل نسبي لمكان هذا الملف، لذا تعمل تلقائيًا
# سواء تم التركيب في الجذر أو داخل مجلد فرعي.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # توحيد النطاق لمحركات البحث: www تتحول للنطاق الأساسي (301)
    RewriteCond %{HTTPS} on
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # إزالة الشرطة المائلة الزائدة لمنع ازدواجية المحتوى (المجلدات الحقيقية مستثناة)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^(.+)/$ $1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # مسارات لوحة التحكم لها نقطة دخول مستقلة admin/index.php
    # التوجيه بدون لاحقة PATH_INFO لضمان العمل حتى على الاستضافات التي تعطّل AcceptPathInfo،
    # حيث يستخرج النظام المسار المطلوب من REQUEST_URI تلقائيًا.
    RewriteRule ^admin/ admin/index.php [L]

    RewriteRule ^index\.php - [L]
    RewriteRule . index.php [L]
</IfModule>

# منع عرض محتويات المجلدات
Options -Indexes

# منع الوصول المباشر لملفات الإعدادات والنظام الحساسة
<FilesMatch "^(config\.php|composer\.json|composer\.lock|\.env)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# منع تنفيذ PHP داخل مجلد الرفع
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^.*/storage/uploads/.*\.php$ [NC]
    RewriteRule ^ - [F,L]

    # منع تقديم محتوى ويب نشط من مجلد الرفع حتى لو كان ملفًا قديمًا.
    RewriteCond %{REQUEST_URI} ^.*/storage/uploads/ [NC]
    RewriteCond %{REQUEST_URI} \.(html?|xhtml|shtml|svg|xml|xsl|js|mjs|css|cgi|pl|py|sh)$ [NC]
    RewriteRule ^ - [F,L]
</IfModule>
